# =============================================================================
# 📧 RESEND EMAIL CONFIGURATION
# =============================================================================

# 🔑 Clé API Resend pour l'envoi d'emails
# ⚠️  CRITIQUE : Cette clé est nécessaire pour tous les emails (confirmation, bienvenue, reset)
RESEND_API_KEY=your_resend_api_key_here

# =============================================================================
# 🌐 APPLICATION CONFIGURATION
# =============================================================================

# Environnement de l'application
NODE_ENV=production
VITE_APP_ENV=production
VITE_APP_URL=https://ciara.city
VITE_API_URL=https://ciara.city/api

# =============================================================================
# 🔍 ANALYTICS ET DEBUG
# =============================================================================

VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false
VITE_ENABLE_CSP=true
VITE_ENABLE_HSTS=true
VITE_ENABLE_XSS_PROTECTION=true

# =============================================================================
# 🤖 AI SERVICES
# =============================================================================

# Clé API OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# 🗺️ GOOGLE SERVICES
# =============================================================================

# Clé API Google Maps
VITE_GOOGLE_MAPS_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 🛡️ SÉCURITÉ (OPTIONNEL)
# =============================================================================

# Mode simulation pour la sécurité
VITE_SECURITY_DRY_RUN=false

# Validation stricte des entrées
VITE_ENABLE_STRICT_VALIDATION=true

# Sessions sécurisées
VITE_ENABLE_SECURE_SESSIONS=true

# Chiffrement du cache
VITE_ENABLE_CACHE_ENCRYPTION=true

# Limitation de débit
VITE_ENABLE_RATE_LIMITING=true
VITE_RATE_LIMIT_PER_MINUTE=100

# Sécurité des API
VITE_ENABLE_API_SECURITY=true

# Longueur maximale des entrées
VITE_MAX_INPUT_LENGTH=1000

# Timeout des sessions
VITE_SESSION_TIMEOUT_MINUTES=60

# Debug de sécurité
VITE_SECURITY_DEBUG=false

# En-têtes de sécurité
VITE_ENABLE_SECURITY_HEADERS=true

# Cookies sécurisés
VITE_ENABLE_SECURE_COOKIES=true

# Validation des URLs
VITE_ENABLE_URL_VALIDATION=true

# Protection contre les injections
VITE_ENABLE_INJECTION_PROTECTION=true

# Journalisation de sécurité
VITE_ENABLE_SECURITY_LOGGING=true

# Mode test de sécurité
VITE_SECURITY_TEST_MODE=false

# =============================================================================
# 📋 INSTRUCTIONS D'INSTALLATION
# =============================================================================

# 1. Copier ce fichier vers .env
#    cp env.complete.template .env
#
# 2. Remplir les valeurs manquantes :
#    - SUPABASE_SERVICE_ROLE_KEY : Dans Supabase Dashboard > Settings > API
#    - RESEND_API_KEY : Dans votre compte Resend
#    - OPENAI_API_KEY : Dans votre compte OpenAI
#
# 3. Vérifier que .env est dans .gitignore
#
# 4. Redéployer les fonctions Edge :
#    cd supabase
#    supabase functions deploy auth-webhook
#    supabase functions deploy send-welcome-ciara
#    supabase functions deploy send-password-reset
#
# 5. Tester l'authentification complète

# =============================================================================
# 🔍 VÉRIFICATION POST-INSTALLATION
# =============================================================================

# Après avoir rempli .env, exécuter :
# node audit-configuration-complete.mjs
#
# Toutes les variables critiques doivent être marquées ✅ PRÉSENTE
